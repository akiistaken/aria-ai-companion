// A stroked, round-capped icon. Every icon in the app renders through this component so
// weight and cap style stay identical. Stroke weight is expressed in 24-unit viewbox units.
export component Icon inherits Rectangle {
    in property <string> d;
    in property <length> size: 18px;
    in property <color> tint: Theme.text-secondary;
    in property <length> weight: 1.7px;

    width: size;
    height: size;
    background: transparent;

    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.d;
        stroke: root.tint;
        stroke-width: root.weight;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}
