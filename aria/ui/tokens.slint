// Design tokens for Aria.
//
// World: graphite instrument panel. Near-neutral dark surfaces, 1px hairlines, one accent that
// tracks Aria's live mood. The avatar is the only saturated surface on the desktop; the chrome
// around it stays quiet so the character reads first.

export global Theme {
    // Ground
    out property <color> canvas: #0a0b0d;
    out property <color> surface: #121418;
    out property <color> surface-raised: #171a1f;
    out property <color> surface-sunken: #0d0f12;

    // Lines
    out property <color> hairline: #24282f;
    out property <color> hairline-strong: #333941;

    // Text (secondary/tertiary both clear 4.5:1 and 3:1 on surface)
    out property <color> text: #eceef1;
    out property <color> text-secondary: #9aa3ae;
    out property <color> text-muted: #767f8b;

    // Semantic
    out property <color> danger: #f2555a;
    out property <color> success: #3ddc97;
    out property <color> warning: #f0b143;

    // Live persona accent, driven from Rust.
    in-out property <color> accent: #38bdf8;
    in-out property <string> accent-hex: "#38bdf8";
    in-out property <string> persona-badge: "TSUNDERE";
    in-out property <string> persona-name: "Tsundere";

    out property <length> r-sm: 6px;
    out property <length> r-md: 10px;
    out property <length> r-lg: 14px;
    out property <length> r-pill: 999px;

    out property <length> s-1: 4px;
    out property <length> s-2: 8px;
    out property <length> s-3: 12px;
    out property <length> s-4: 16px;
    out property <length> s-5: 24px;
    out property <length> s-6: 32px;

    out property <string> font-ui: "Segoe UI";
    out property <string> font-display: "Segoe UI Variable Display";
    out property <string> font-mono: "Cascadia Mono";
}

// Derived accent tints; Slint cannot mix colors in an expression, so these are set from Rust
// alongside Theme.accent (see ui_bridge).
export global Accent {
    in-out property <color> wash: #12232c;
    in-out property <color> edge: #1f5f7a;
}

