// Context menu for the mascot: a short, honest list. Deep settings live in the Control Center.

import { Theme, Accent, Glyph, Icon } from "tokens.slint";

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <bool> danger: false;
    in property <string> accent-text: "";
    callback activated();

    height: 32px;
    background: hit.has-hover ? Theme.surface-raised : transparent;
    border-radius: 6px;

    Icon {
        x: 10px;
        y: (parent.height - self.height) / 2;
        d: root.icon;
        size: 14px;
        tint: root.danger ? Theme.danger : (hit.has-hover ? Theme.accent : Theme.text-secondary);
    }
    Text {
        x: 34px;
        width: parent.width - 50px;
        height: parent.height;
        text: root.label;
        color: root.danger ? Theme.danger : Theme.text;
        font-size: 12px;
        font-family: Theme.font-ui;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }
    Text {
        x: 34px;
        width: parent.width - 50px;
        height: parent.height;
        text: root.accent-text;
        color: Theme.text-muted;
        font-size: 12px;
        font-family: Theme.font-ui;
        vertical-alignment: center;
        horizontal-alignment: right;
    }

    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.hairline;
    width: 100%;
}

export component ContextMenu inherits Window {
    title: "Aria";
    background: transparent;
    width: 268px;
    height: layout.preferred-height + 12px;

    in-out property <color> accent-color: #38bdf8;
    in-out property <color> accent-wash: #12232c;
    in-out property <color> accent-edge: #1f5f7a;
    in property <string> mood-badge: "TSUNDERE";
    in property <int> memory-count: 0;
    in property <bool> mic-open: false;

    callback summon();
    callback toggle-chatbox();
    callback open-studio();
    callback quick-dial();
    callback open-vault();
    callback set-key();
    callback toggle-mic-mode();
    callback reset-pose();
    callback open-log();
    callback quit();

    init => {
        Accent.wash = root.accent-wash;
        Accent.edge = root.accent-edge;
        Theme.accent = root.accent-color;
    }
    changed accent-color => { Theme.accent = root.accent-color; }
    changed accent-wash => { Accent.wash = root.accent-wash; }
    changed accent-edge => { Accent.edge = root.accent-edge; }

    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: Theme.r-md;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.hairline-strong;
        drop-shadow-blur: 22px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000a0;

        layout := VerticalLayout {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            spacing: 1px;

            // Mood header
            Rectangle {
                height: 34px;
                background: transparent;
                HorizontalLayout {
                    x: 6px;
                    width: parent.width - 12px;
                    height: parent.height;
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        y: (parent.height - 6px) / 2;
                        background: Theme.accent;
                    }
                    Text {
                        text: root.mood-badge;
                        color: Theme.accent;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.7px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.memory-count + " memories";
                        color: Theme.text-muted;
                        font-size: 10.5px;
                        font-family: Theme.font-ui;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: parent.width;
                    }
                }
            }

            Divider { }

            MenuItem { label: "Ask Aria"; icon: Glyph.bubble; accent-text: "Alt+Space"; activated => { root.summon(); } }
            MenuItem {
                label: "Show chat box";
                icon: Glyph.eye;
                activated => { root.toggle-chatbox(); }
            }
            MenuItem {
                label: root.mic-open ? "Mic: open (VAD)" : "Mic: click to talk";
                icon: Glyph.mic;
                activated => { root.toggle-mic-mode(); }
            }

            Divider { }

            MenuItem { label: "Control Center"; icon: Glyph.sliders; accent-text: "Ctrl+Shift+C"; activated => { root.open-studio(); } }
            MenuItem { label: "Quick dial"; icon: Glyph.target; activated => { root.quick-dial(); } }
            MenuItem { label: "Memory vault"; icon: Glyph.list; activated => { root.open-vault(); } }
            MenuItem { label: "Reset pose"; icon: Glyph.refresh; activated => { root.reset-pose(); } }

            Divider { }

            MenuItem { label: "Set API key"; icon: Glyph.key; activated => { root.set-key(); } }
            MenuItem { label: "Open log"; icon: Glyph.doc; activated => { root.open-log(); } }
            MenuItem { label: "Quit Aria"; icon: Glyph.power; danger: true; activated => { root.quit(); } }
        }
    }
}
