// Aria Control Center: a sidebar + content studio.
//
// Operate mode: density is welcome, novelty is not. One nav column, one content column, every
// control has a visible label, and the live mood/emotion state is always on screen because that
// is the thing you come here to read.
//
// Layout rule: nothing in here carries a hard-coded height that has to agree with its content.
// Cards, rows and sections size from their children, so copy can change without clipping.

import { Theme, Accent, Glyph, Icon } from "tokens.slint";
import { ScrollView } from "std-widgets.slint";

export struct EmotionRow {
    key: string,
    icon: string,
    title: string,
    tier: string,
    level: string,
    percent: float,
    color: color,
    tint: color,
}

export struct TraitRow {
    key: string,
    name: string,
    label: string,
    desc: string,
    percent: int,
    color: color,
}

export struct PropCell {
    key: string,
    label: string,
    active: bool,
}

export struct FactRow {
    text: string,
    meta: string,
}

export struct Choice {
    key: string,
    label: string,
}

export struct DeviceEntry {
    name: string,
}

export component SectionTitle inherits Text {
    in property <string> title;
    in property <string> hint: "";
    text: root.title;
    color: Theme.text;
    font-size: 13px;
    font-weight: 600;
    font-family: Theme.font-ui;
    horizontal-alignment: left;
}

// Heading + body. Sections are spaced wider than a heading is from its own card.
component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> note: "";
    spacing: 8px;

    VerticalLayout {
        spacing: 2px;
        SectionTitle { title: root.title; }
        if root.note != "" : Text {
            text: root.note;
            color: Theme.text-muted;
            font-size: 11.5px;
            font-family: Theme.font-ui;
            wrap: word-wrap;
        }
    }
    @children
}

// A surface that sizes from its content.
component Card inherits Rectangle {
    in property <length> pad-x: 16px;
    in property <length> pad-y: 14px;
    in property <length> gap: 12px;

    background: Theme.surface;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.hairline;

    VerticalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: root.gap;
        @children
    }
}

// Label column + control. Labels share one width so controls line up down a card.
component FormRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;
    min-height: 34px;

    Text {
        width: 88px;
        text: root.label;
        color: Theme.text-secondary;
        font-size: 12px;
        font-family: Theme.font-ui;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

// A labelled switch row. The whole row is the hit target.
component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <bool> checked: false;
    in property <bool> divider: false;
    callback toggled(bool);

    height: root.hint == "" ? 44px : 54px;
    background: row.has-hover ? Theme.surface-raised : transparent;
    border-radius: Theme.r-sm;

    Rectangle {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: 1px;
        background: Theme.hairline;
        visible: root.divider && !row.has-hover;
    }

    VerticalLayout {
        x: 12px;
        width: parent.width - 80px;
        y: 0;
        height: parent.height;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.label;
            color: Theme.text;
            font-size: 12.5px;
            font-family: Theme.font-ui;
            horizontal-alignment: left;
            wrap: no-wrap;
            overflow: elide;
        }
        if root.hint != "" : Text {
            text: root.hint;
            color: Theme.text-muted;
            font-size: 11.5px;
            font-family: Theme.font-ui;
            horizontal-alignment: left;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    // Switch track
    Rectangle {
        x: parent.width - 52px;
        y: (parent.height - 22px) / 2;
        width: 38px;
        height: 22px;
        border-radius: 11px;
        background: root.checked ? Theme.accent : Theme.surface-sunken;
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.hairline-strong;

        animate background { duration: 140ms; easing: ease-out; }
        animate border-color { duration: 140ms; easing: ease-out; }

        Rectangle {
            width: 16px;
            height: 16px;
            y: 2px;
            x: root.checked ? parent.width - 18px : 2px;
            border-radius: 8px;
            background: root.checked ? Theme.canvas : Theme.text-secondary;
            animate x { duration: 160ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
        }
    }

    row := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

// Single-choice radio list. The option labels are descriptive phrases ("Auto — synced to time
// of day"), far too long for a segmented control, so each gets its own full-width row.
component OptionList inherits VerticalLayout {
    in property <string> label;
    in property <[Choice]> options;
    in property <int> selected: 0;
    callback chosen(int);
    spacing: 6px;

    if root.label != "" : Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: 12px;
        font-family: Theme.font-ui;
    }

    VerticalLayout {
        spacing: 2px;
        for option[index] in root.options : Rectangle {
            property <bool> on: root.selected == index;
            height: 34px;
            border-radius: Theme.r-sm;
            background: self.on ? Accent.wash : (hit.has-hover ? Theme.surface-raised : transparent);
            border-width: 1px;
            border-color: self.on ? Accent.edge : transparent;

            Rectangle {
                x: 11px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: parent.on ? 5px : 1.5px;
                border-color: parent.on ? Theme.accent : (hit.has-hover ? Theme.text-secondary : Theme.hairline-strong.brighter(0.4));
                background: parent.on ? Theme.canvas : transparent;
                animate border-width { duration: 120ms; easing: ease-out; }
            }
            Text {
                x: 37px;
                width: parent.width - 47px;
                height: parent.height;
                text: option.label;
                color: parent.on ? Theme.text : (hit.has-hover ? Theme.text : Theme.text-secondary);
                font-size: 12.5px;
                font-weight: parent.on ? 600 : 400;
                font-family: Theme.font-ui;
                vertical-alignment: center;
                overflow: elide;
            }

            hit := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.chosen(index); }
            }
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    width: content.preferred-width + 24px;
    border-radius: Theme.r-sm;
    background: root.primary
        ? (hit.pressed ? Theme.accent.darker(0.15) : (hit.has-hover ? Theme.accent.brighter(0.12) : Theme.accent))
        : root.danger
            ? (hit.pressed ? Theme.danger.darker(0.15) : (hit.has-hover ? Theme.danger : Theme.surface-sunken))
            : root.active
                ? Accent.wash
                : (hit.pressed ? Theme.surface : (hit.has-hover ? Theme.surface-raised : Theme.surface-sunken));
    border-width: 1px;
    border-color: root.primary ? Theme.accent
        : root.danger ? (hit.has-hover ? Theme.danger : Theme.danger-edge)
        : root.active ? Accent.edge
        : (hit.has-hover ? Theme.hairline-strong.brighter(0.25) : Theme.hairline-strong);

    animate background { duration: 110ms; easing: ease-out; }

    property <color> ink: root.primary ? Theme.canvas
        : root.danger ? (hit.has-hover ? Theme.canvas : Theme.danger)
        : root.active ? Theme.accent
        : Theme.text;

    // Fills the button and centres its content. (Offsetting by x as well as centring
    // shifted the label right by half the offset and clipped its last letters.)
    content := HorizontalLayout {
        spacing: 7px;
        alignment: center;

        if root.icon != "" : VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                size: 14px;
                tint: root.primary || root.danger || root.active ? root.ink : Theme.text-secondary;
            }
        }
        Text {
            text: root.label;
            color: root.ink;
            font-size: 12px;
            font-weight: 600;
            font-family: Theme.font-ui;
            vertical-alignment: center;
        }
    }

    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Single-line input. `text` is two-way so callers can bind a draft property to it.
component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    callback edited(string);
    callback accepted(string);

    height: 34px;
    min-width: 120px;
    horizontal-stretch: 1;
    background: Theme.surface-sunken;
    border-radius: Theme.r-sm;
    border-width: 1px;
    border-color: field.has-focus ? Theme.accent : (hover.has-hover ? Theme.hairline-strong.brighter(0.25) : Theme.hairline-strong);

    hover := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { field.focus(); }
    }

    Text {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: 12.5px;
        font-family: Theme.font-ui;
        vertical-alignment: center;
        overflow: elide;
        visible: root.text == "";
    }

    field := TextInput {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text <=> root.text;
        color: Theme.text;
        selection-background-color: Accent.edge;
        selection-foreground-color: Theme.text;
        font-size: 12.5px;
        font-family: Theme.font-ui;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
}

// Horizontal drag meter: track, fill, and value read-out above it.
component Slider inherits Rectangle {
    in property <float> fraction: 0.5;
    in property <color> fill: Theme.accent;
    callback moved-to(float);

    height: 18px;
    min-width: 120px;
    background: transparent;

    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        border-radius: 3px;
        background: Theme.surface-sunken;
        border-width: 1px;
        border-color: Theme.hairline-strong;

        Rectangle {
            x: 0;
            width: parent.width * clamp(root.fraction, 0.0, 1.0);
            border-radius: 3px;
            background: root.fill;
            animate width { duration: 90ms; easing: ease-out; }
        }
    }

    // Thumb
    Rectangle {
        x: (parent.width - 14px) * clamp(root.fraction, 0.0, 1.0);
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.text;
        border-width: 3px;
        border-color: drag.pressed || drag.has-hover ? root.fill : Theme.surface;
        animate x { duration: 90ms; easing: ease-out; }
    }

    drag := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.moved-to(clamp(self.mouse-x / max(1px, self.width), 0.0, 1.0));
            }
        }
        moved => {
            if (self.pressed) {
                root.moved-to(clamp(self.mouse-x / max(1px, self.width), 0.0, 1.0));
            }
        }
    }
}

// Emotion EXP meter, the studio's signature read-out.
component EmotionMeter inherits VerticalLayout {
    in property <EmotionRow> data;
    spacing: 6px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.data.title;
            color: Theme.text;
            font-size: 12.5px;
            font-weight: 600;
            font-family: Theme.font-ui;
            horizontal-stretch: 1;
        }
        Text {
            text: root.data.tier + "  ·  " + root.data.level;
            color: root.data.tint;
            font-size: 11.5px;
            font-family: Theme.font-ui;
            horizontal-alignment: right;
        }
    }
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.surface-sunken;
        border-width: 1px;
        border-color: Theme.hairline-strong;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.data.percent, 0.0, 1.0);
            border-radius: 3px;
            background: root.data.color;
            animate width { duration: 260ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
        }
    }
}

component TraitControl inherits VerticalLayout {
    in property <TraitRow> data;
    callback changed(string, int);
    spacing: 4px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.data.name;
            color: Theme.text;
            font-size: 12.5px;
            font-weight: 600;
            font-family: Theme.font-ui;
            horizontal-stretch: 1;
        }
        Text {
            text: root.data.percent + "%";
            color: root.data.color;
            font-size: 12px;
            font-weight: 700;
            font-family: Theme.font-ui;
            horizontal-alignment: right;
        }
    }
    if root.data.desc != "" : Text {
        text: root.data.desc;
        color: Theme.text-muted;
        font-size: 11.5px;
        font-family: Theme.font-ui;
        overflow: elide;
    }
    Slider {
        fraction: root.data.percent / 100;
        fill: root.data.color;
        moved-to(f) => { root.changed(root.data.key, round(f * 100)); }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <bool> selected: false;
    in property <bool> danger: false;
    callback activated();

    height: 36px;
    border-radius: Theme.r-sm;
    background: root.selected ? Accent.wash : (hit.has-hover ? Theme.surface-raised : transparent);
    border-width: 1px;
    border-color: root.selected ? Accent.edge : transparent;

    Icon {
        x: 11px;
        y: (parent.height - self.height) / 2;
        d: root.icon;
        size: 16px;
        tint: root.selected ? Theme.accent
            : root.danger && hit.has-hover ? Theme.danger
            : (hit.has-hover ? Theme.text : Theme.text-secondary);
    }
    Text {
        x: 37px;
        width: parent.width - 45px;
        height: parent.height;
        text: root.label;
        color: root.selected ? Theme.text
            : root.danger && hit.has-hover ? Theme.danger
            : (hit.has-hover ? Theme.text : Theme.text-secondary);
        font-size: 12.5px;
        font-weight: root.selected ? 600 : 400;
        font-family: Theme.font-ui;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }

    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

component Shortcut inherits HorizontalLayout {
    in property <string> keys;
    in property <string> action;
    spacing: 16px;
    min-height: 26px;

    Rectangle {
        width: 168px;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: key-label.preferred-width + 14px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                background: Theme.surface-sunken;
                border-width: 1px;
                border-color: Theme.hairline-strong;
                key-label := Text {
                    text: root.keys;
                    color: Theme.text;
                    font-size: 11px;
                    font-family: Theme.font-mono;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    Text {
        text: root.action;
        color: Theme.text-secondary;
        font-size: 12px;
        font-family: Theme.font-ui;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

export component ControlCenter inherits Window {
    title: "Aria Control Center";
    background: Theme.canvas;
    preferred-width: 940px;
    preferred-height: 720px;
    min-width: 780px;
    min-height: 540px;
    default-font-family: Theme.font-ui;

    in-out property <color> accent-color: #38bdf8;
    in-out property <color> accent-wash: #12232c;
    in-out property <color> accent-edge: #1f5f7a;

    // Live state
    in-out property <string> mood-badge: "TSUNDERE";
    in-out property <string> mood-name: "Tsundere";
    in-out property <string> mood-reason: "autonomous mood";
    in-out property <string> affection-label: "Sweet Companion (Lvl 2)";
    in-out property <[EmotionRow]> emotions;
    in-out property <[TraitRow]> traits;
    in-out property <[PropCell]> props;
    in-out property <[FactRow]> facts;
    in-out property <[Choice]> voices;
    in-out property <[Choice]> models;
    in-out property <[Choice]> framings;
    in-out property <[Choice]> lightings;
    in-out property <[Choice]> mic-modes;
    in-out property <[Choice]> reasonings;
    in-out property <[DeviceEntry]> inputs;
    in-out property <[DeviceEntry]> outputs;

    in-out property <int> voice-index: 0;
    in-out property <int> model-index: 0;
    in-out property <int> framing-index: 1;
    in-out property <int> lighting-index: 0;
    in-out property <int> mic-index: 2;
    in-out property <int> reasoning-index: 0;
    in-out property <int> input-index: 0;
    in-out property <int> output-index: 0;
    in-out property <int> tab: 0;

    in property <bool> tts-on: true;
    in property <bool> wake-word: false;
    in property <bool> music-vibe: true;
    in property <bool> proactive: true;
    in property <bool> presence: true;
    in property <bool> clipboard: true;
    in property <bool> gaming-copilot: true;
    in property <bool> game-dodge: true;
    in property <bool> edge-snap: true;
    in property <bool> discord: false;
    in property <bool> subtitles: true;
    in property <bool> chatbox: true;
    in property <bool> capsule: true;
    in property <bool> capsule-autohide: true;
    in property <bool> voice-follows-mood: false;
    in property <bool> idle-events: true;
    in property <bool> cua: true;
    in property <string> cua-status: "";
    in property <float> avatar-scale: 1.0;
    in property <string> base-url: "";
    in property <string> api-key-masked: "";
    in property <string> status-text: "All settings apply live.";

    in-out property <string> fact-draft: "";

    callback set-tab(int);
    callback toggle-tts(bool);
    callback pick-voice(int);
    callback audition-voice();
    callback clone-voice-file();
    callback toggle-wake-word(bool);
    callback pick-mic-mode(int);
    callback pick-input(int);
    callback pick-output(int);
    callback toggle-music-vibe(bool);
    callback toggle-proactive(bool);
    callback toggle-presence(bool);
    callback toggle-clipboard(bool);
    callback toggle-gaming(bool);
    callback toggle-dodge(bool);
    callback toggle-edge-snap(bool);
    callback toggle-discord(bool);
    callback toggle-subtitles(bool);
    callback toggle-chatbox(bool);
    callback toggle-capsule(bool);
    callback toggle-capsule-autohide(bool);
    callback toggle-voice-mood(bool);
    callback pick-model(int);
    callback pick-reasoning(int);
    callback toggle-idle-events(bool);
    callback toggle-cua(bool);
    callback save-engine(string, string);
    callback pick-framing(int);
    callback pick-lighting(int);
    callback set-avatar-scale(float);
    callback reset-camera();
    callback load-vrm();
    callback toggle-prop(string);
    callback headpat();
    callback tease();
    callback hype();
    callback groove();
    callback reset-emotions();
    callback trait-changed(string, int);
    callback add-fact(string);
    callback add-todo();
    callback run-briefing();
    callback reset-conversation();
    callback reset-avatar();
    callback quit-app();
    callback open-log();

    init => {
        Accent.wash = root.accent-wash;
        Accent.edge = root.accent-edge;
        Theme.accent = root.accent-color;
    }
    changed accent-color => { Theme.accent = root.accent-color; }
    changed accent-wash => { Accent.wash = root.accent-wash; }
    changed accent-edge => { Accent.edge = root.accent-edge; }

    function remember() {
        if (root.fact-draft != "") {
            root.add-fact(root.fact-draft);
            root.fact-draft = "";
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // ---- Header: identity + live mood ----
        Rectangle {
            height: 68px;
            background: Theme.surface-sunken;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.hairline;
            }

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 20px;
                spacing: 16px;

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;

                    Text {
                        text: "Aria";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 600;
                        font-family: Theme.font-display;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: Theme.accent;
                            }
                        }
                        Text {
                            text: root.mood-name;
                            color: Theme.accent;
                            font-size: 12px;
                            font-weight: 600;
                            font-family: Theme.font-ui;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.mood-reason + "  ·  " + root.affection-label;
                            color: Theme.text-secondary;
                            font-size: 12px;
                            font-family: Theme.font-ui;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    ActionButton {
                        label: "Reset pose";
                        icon: Glyph.refresh;
                        clicked => { root.reset-avatar(); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;

            // ---- Sidebar ----
            sidebar := Rectangle {
                width: 212px;
                background: Theme.surface-sunken;

                Rectangle {
                    x: sidebar.width - 1px;
                    width: 1px;
                    background: Theme.hairline;
                }

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 13px;
                    padding-top: 16px;
                    padding-bottom: 12px;
                    spacing: 2px;

                    NavItem { label: "Studio & wardrobe"; icon: Glyph.spark; selected: root.tab == 0; activated => { root.set-tab(0); } }
                    NavItem { label: "Personality"; icon: Glyph.heart; selected: root.tab == 1; activated => { root.set-tab(1); } }
                    NavItem { label: "Voice & audio"; icon: Glyph.mic; selected: root.tab == 2; activated => { root.set-tab(2); } }
                    NavItem { label: "Presence & gaming"; icon: Glyph.gamepad; selected: root.tab == 3; activated => { root.set-tab(3); } }
                    NavItem { label: "Engine & system"; icon: Glyph.sliders; selected: root.tab == 4; activated => { root.set-tab(4); } }

                    Rectangle { vertical-stretch: 1; min-height: 0px; }

                    Rectangle {
                        height: 1px;
                        background: Theme.hairline;
                    }
                    Rectangle { height: 6px; }

                    NavItem { label: "Open log"; icon: Glyph.doc; activated => { root.open-log(); } }
                    NavItem { label: "Quit Aria"; icon: Glyph.power; danger: true; activated => { root.quit-app(); } }
                }
            }

            // ---- Content ----
            sv := ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: content.preferred-height;

                content := HorizontalLayout {
                    width: sv.visible-width;
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 24px;
                    padding-bottom: 32px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        max-width: 720px;
                        spacing: 28px;
                        alignment: start;

                        // ============ TAB 0: Studio & wardrobe ============
                        if root.tab == 0 : VerticalLayout {
                            spacing: 28px;

                            Section {
                                title: "Wardrobe";
                                note: "Accessories attach to the live avatar and persist across restarts.";
                                Card {
                                    gap: 8px;
                                    for row[k] in Math.ceil(root.props.length / 3) : HorizontalLayout {
                                        spacing: 8px;
                                        for cell[m] in 3 : cell-r := Rectangle {
                                            property <int> idx: k * 3 + m;
                                            property <bool> real: self.idx < root.props.length;
                                            property <bool> on: self.real && root.props[self.idx].active;
                                            horizontal-stretch: 1;
                                            height: 36px;
                                            border-radius: Theme.r-sm;
                                            opacity: self.real ? 1 : 0;
                                            background: self.on ? Accent.wash : (prop-hit.has-hover ? Theme.surface-raised : Theme.surface-sunken);
                                            border-width: 1px;
                                            border-color: self.on ? Accent.edge : (prop-hit.has-hover ? Theme.hairline-strong : Theme.hairline);

                                            Rectangle {
                                                x: 11px;
                                                y: (parent.height - 14px) / 2;
                                                width: 14px;
                                                height: 14px;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                background: parent.on ? Theme.accent : transparent;
                                                border-color: parent.on ? Theme.accent : Theme.hairline-strong.brighter(0.3);
                                                Icon {
                                                    x: 1px;
                                                    y: 1px;
                                                    d: Glyph.check;
                                                    size: 12px;
                                                    weight: 2.4px;
                                                    tint: Theme.canvas;
                                                    visible: cell-r.on;
                                                }
                                            }
                                            Text {
                                                x: 33px;
                                                width: parent.width - 42px;
                                                height: parent.height;
                                                text: parent.real ? root.props[parent.idx].label : "";
                                                color: parent.on ? Theme.text : Theme.text-secondary;
                                                font-size: 12px;
                                                font-family: Theme.font-ui;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            prop-hit := TouchArea {
                                                enabled: parent.real;
                                                mouse-cursor: pointer;
                                                clicked => { root.toggle-prop(root.props[parent.idx].key); }
                                            }
                                        }
                                    }
                                    if root.props.length == 0 : Text {
                                        text: "No accessories found for this model.";
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                    }
                                }
                            }

                            Section {
                                title: "Camera & scale";
                                Card {
                                    gap: 18px;
                                    OptionList {
                                        label: "Framing";
                                        options: root.framings;
                                        selected: root.framing-index;
                                        chosen(idx) => { root.pick-framing(idx); }
                                    }
                                    OptionList {
                                        label: "Lighting";
                                        options: root.lightings;
                                        selected: root.lighting-index;
                                        chosen(idx) => { root.pick-lighting(idx); }
                                    }
                                    Rectangle { height: 1px; background: Theme.hairline; }
                                    FormRow {
                                        label: "Avatar size";
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Slider {
                                                fraction: (root.avatar-scale - 0.5) / 2.0;
                                                moved-to(f) => { root.set-avatar-scale(0.5 + f * 2.0); }
                                            }
                                        }
                                        Text {
                                            width: 44px;
                                            text: round(root.avatar-scale * 100) + "%";
                                            color: Theme.accent;
                                            font-size: 12px;
                                            font-weight: 700;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        ActionButton {
                                            label: "Reset zoom";
                                            icon: Glyph.refresh;
                                            clicked => { root.reset-camera(); }
                                        }
                                    }
                                }
                            }

                            Section {
                                title: "Avatar source";
                                HorizontalLayout {
                                    alignment: start;
                                    ActionButton { label: "Load VRM…"; icon: Glyph.folder; clicked => { root.load-vrm(); } }
                                }
                            }
                        }

                        // ============ TAB 1: Personality ============
                        if root.tab == 1 : VerticalLayout {
                            spacing: 28px;

                            Section {
                                title: "Autonomous mood";
                                Card {
                                    gap: 6px;
                                    Text {
                                        text: root.mood-name;
                                        color: Theme.accent;
                                        font-size: 22px;
                                        font-weight: 600;
                                        font-family: Theme.font-display;
                                    }
                                    Text {
                                        text: "Aria picks her own personality from what you're doing, how you speak to her, and the hour. This is a read-out, not a setting.";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        font-family: Theme.font-ui;
                                        wrap: word-wrap;
                                    }
                                }
                                Card {
                                    pad-x: 4px;
                                    pad-y: 4px;
                                    gap: 0px;
                                    ToggleRow {
                                        label: "Voice follows mood";
                                        hint: "Swap the TTS voice when her personality shifts";
                                        checked: root.voice-follows-mood;
                                        toggled(v) => { root.toggle-voice-mood(v); }
                                    }
                                }
                            }

                            Section {
                                title: "Emotion EXP";
                                Card {
                                    gap: 16px;
                                    for e in root.emotions : EmotionMeter { data: e; }
                                    Rectangle { height: 1px; background: Theme.hairline; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton { label: "Headpat"; icon: Glyph.heart; clicked => { root.headpat(); } }
                                        ActionButton { label: "Tease"; icon: Glyph.bolt; clicked => { root.tease(); } }
                                        ActionButton { label: "Hype"; icon: Glyph.spark; clicked => { root.hype(); } }
                                        ActionButton { label: "Vibe"; icon: Glyph.wave; clicked => { root.groove(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                        ActionButton { label: "Reset"; icon: Glyph.refresh; clicked => { root.reset-emotions(); } }
                                    }
                                }
                            }

                            Section {
                                title: "Baseline traits";
                                note: "Drag to set where her mood settles when nothing is happening.";
                                Card {
                                    gap: 18px;
                                    for t in root.traits : TraitControl {
                                        data: t;
                                        changed(key, value) => { root.trait-changed(key, value); }
                                    }
                                }
                            }

                            Section {
                                title: "Memory vault";
                                note: root.facts.length == 0
                                    ? "Nothing remembered yet. Aria learns facts from conversation, or add one below."
                                    : root.facts.length + (root.facts.length == 1 ? " remembered fact" : " remembered facts");
                                Card {
                                    gap: 12px;

                                    if root.facts.length > 0 : Rectangle {
                                        height: min(root.facts.length * 32px + 8px, 232px);
                                        background: Theme.surface-sunken;
                                        border-radius: Theme.r-sm;
                                        border-width: 1px;
                                        border-color: Theme.hairline;

                                        ScrollView {
                                            content-width: self.width;
                                            content-height: fact-list.preferred-height;
                                            fact-list := VerticalLayout {
                                                padding: 4px;
                                                spacing: 0px;
                                                for f in root.facts : Rectangle {
                                                    height: 32px;
                                                    background: row-f.has-hover ? Theme.surface-raised : transparent;
                                                    border-radius: Theme.r-sm - 2px;
                                                    Text {
                                                        x: 10px;
                                                        width: parent.width - (f.meta == "" ? 20px : 110px);
                                                        height: parent.height;
                                                        text: f.text;
                                                        color: Theme.text;
                                                        font-size: 12px;
                                                        font-family: Theme.font-ui;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        x: parent.width - 100px;
                                                        width: 90px;
                                                        height: parent.height;
                                                        text: f.meta;
                                                        color: Theme.text-muted;
                                                        font-size: 11px;
                                                        font-family: Theme.font-ui;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    row-f := TouchArea { mouse-cursor: default; }
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        TextField {
                                            text <=> root.fact-draft;
                                            placeholder: "Something to remember…";
                                            accepted => { root.remember(); }
                                        }
                                        ActionButton {
                                            label: "Remember";
                                            primary: true;
                                            clicked => { root.remember(); }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton { label: "Briefing"; icon: Glyph.clock; clicked => { root.run-briefing(); } }
                                    ActionButton { label: "Add to-do"; icon: Glyph.plus; clicked => { root.add-todo(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    ActionButton { label: "Reset conversation"; icon: Glyph.refresh; danger: true; clicked => { root.reset-conversation(); } }
                                }
                            }
                        }

                        // ============ TAB 2: Voice & audio ============
                        if root.tab == 2 : VerticalLayout {
                            spacing: 28px;

                            Section {
                                title: "Voice";
                                Card {
                                    pad-x: 4px;
                                    pad-y: 4px;
                                    gap: 0px;
                                    ToggleRow {
                                        label: "Spoken replies";
                                        hint: "Synthesize every answer with the selected voice";
                                        checked: root.tts-on;
                                        toggled(v) => { root.toggle-tts(v); }
                                    }
                                }
                                Card {
                                    gap: 12px;
                                    FormRow {
                                        label: "Voice";
                                        ActionButton {
                                            label: root.voices.length > 0 ? root.voices[root.voice-index].label : "Default";
                                            icon: Glyph.speaker;
                                            clicked => { root.pick-voice(Math.mod(root.voice-index + 1, Math.max(1, root.voices.length))); }
                                        }
                                        Text {
                                            text: root.voices.length > 1 ? "Click to cycle · " + (root.voice-index + 1) + " of " + root.voices.length : "";
                                            color: Theme.text-muted;
                                            font-size: 11.5px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    FormRow {
                                        label: "";
                                        ActionButton { label: "Audition"; icon: Glyph.play; clicked => { root.audition-voice(); } }
                                        ActionButton { label: "Clone from a clip…"; icon: Glyph.folder; clicked => { root.clone-voice-file(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }

                            Section {
                                title: "Microphone";
                                Card {
                                    pad-x: 4px;
                                    pad-y: 4px;
                                    gap: 0px;
                                    ToggleRow {
                                        label: "“Hey Aria” wake word";
                                        hint: "Listen hands-free and answer when you say her name";
                                        checked: root.wake-word;
                                        toggled(v) => { root.toggle-wake-word(v); }
                                    }
                                }
                                Card {
                                    gap: 18px;
                                    OptionList {
                                        label: "Trigger";
                                        options: root.mic-modes;
                                        selected: root.mic-index;
                                        chosen(idx) => { root.pick-mic-mode(idx); }
                                    }
                                    Rectangle { height: 1px; background: Theme.hairline; }
                                    FormRow {
                                        label: "Input";
                                        ActionButton {
                                            label: root.inputs.length > 0 ? root.inputs[root.input-index].name : "System default";
                                            icon: Glyph.mic;
                                            clicked => { root.pick-input(Math.mod(root.input-index + 1, Math.max(1, root.inputs.length))); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }

                            Section {
                                title: "Output & music";
                                Card {
                                    gap: 12px;
                                    FormRow {
                                        label: "Speakers";
                                        ActionButton {
                                            label: root.outputs.length > 0 ? root.outputs[root.output-index].name : "System default";
                                            icon: Glyph.speaker;
                                            clicked => { root.pick-output(Math.mod(root.output-index + 1, Math.max(1, root.outputs.length))); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                                Card {
                                    pad-x: 4px;
                                    pad-y: 4px;
                                    gap: 0px;
                                    ToggleRow {
                                        label: "Vibe to your music";
                                        hint: "Dances in time to Spotify, YouTube, SoundCloud, Wynk and any player";
                                        checked: root.music-vibe;
                                        toggled(v) => { root.toggle-music-vibe(v); }
                                    }
                                }
                            }
                        }

                        // ============ TAB 3: Presence & gaming ============
                        if root.tab == 3 : VerticalLayout {
                            spacing: 28px;

                            Section {
                                title: "Proactive company";
                                Card {
                                    pad-x: 4px;
                                    pad-y: 4px;
                                    gap: 0px;
                                    ToggleRow {
                                        label: "Proactive reactions";
                                        hint: "Occasional comments on your workflow and hardware";
                                        checked: root.proactive;
                                        toggled(v) => { root.toggle-proactive(v); }
                                    }
                                    ToggleRow {
                                        divider: true;
                                        label: "AFK & posture guardian";
                                        hint: "Notices when you step away and reminds you to move";
                                        checked: root.presence;
                                        toggled(v) => { root.toggle-presence(v); }
                                    }
                                    ToggleRow {
                                        divider: true;
                                        label: "Clipboard bug watcher";
                                        hint: "Diagnoses a traceback the moment you copy it";
                                        checked: root.clipboard;
                                        toggled(v) => { root.toggle-clipboard(v); }
                                    }
                                    ToggleRow {
                                        divider: true;
                                        label: "Idle moments";
                                        hint: "Stretches, twirls and little asides, chosen by the AI to fit her mood";
                                        checked: root.idle-events;
                                        toggled(v) => { root.toggle-idle-events(v); }
                                    }
                                }
                            }

                            Section {
                                title: "Desktop control";
                                Card {
                                    pad-x: 4px;
                                    pad-y: 4px;
                                    gap: 0px;
                                    ToggleRow {
                                        label: "Cua Driver";
                                        hint: root.cua-status;
                                        checked: root.cua;
                                        toggled(v) => { root.toggle-cua(v); }
                                    }
                                }
                            }

                            Section {
                                title: "Gaming";
                                Card {
                                    pad-x: 4px;
                                    pad-y: 4px;
                                    gap: 0px;
                                    ToggleRow {
                                        label: "Game copilot";
                                        hint: "Live screen tips and callouts while you play";
                                        checked: root.gaming-copilot;
                                        toggled(v) => { root.toggle-gaming(v); }
                                    }
                                    ToggleRow {
                                        divider: true;
                                        label: "Smart dodge";
                                        hint: "Shrinks to a corner when a game takes the screen";
                                        checked: root.game-dodge;
                                        toggled(v) => { root.toggle-dodge(v); }
                                    }
                                    ToggleRow {
                                        divider: true;
                                        label: "Magnetic edge snapping";
                                        hint: "Snaps to a bezel and leans in when you drag her close";
                                        checked: root.edge-snap;
                                        toggled(v) => { root.toggle-edge-snap(v); }
                                    }
                                }
                            }

                            Section {
                                title: "Discord";
                                Card {
                                    pad-x: 4px;
                                    pad-y: 4px;
                                    gap: 0px;
                                    ToggleRow {
                                        label: "Rich Presence";
                                        hint: "Show her current mood and affection on your profile";
                                        checked: root.discord;
                                        toggled(v) => { root.toggle-discord(v); }
                                    }
                                }
                            }
                        }

                        // ============ TAB 4: Engine & system ============
                        if root.tab == 4 : VerticalLayout {
                            spacing: 28px;

                            Section {
                                title: "Language model";
                                Card {
                                    gap: 14px;
                                    OptionList {
                                        label: "Model";
                                        options: root.models;
                                        selected: root.model-index;
                                        chosen(idx) => { root.pick-model(idx); }
                                    }
                                    Rectangle { height: 1px; background: Theme.hairline; }
                                    OptionList {
                                        label: "Reasoning";
                                        options: root.reasonings;
                                        selected: root.reasoning-index;
                                        chosen(idx) => { root.pick-reasoning(idx); }
                                    }
                                    Rectangle { height: 1px; background: Theme.hairline; }
                                    FormRow {
                                        label: "Base URL";
                                        url-field := TextField {
                                            text: root.base-url;
                                            placeholder: "https://api.sailresearch.com/v1";
                                            accepted(t) => { root.save-engine(t, ""); }
                                        }
                                        ActionButton {
                                            label: "Save";
                                            clicked => { root.save-engine(url-field.text, ""); }
                                        }
                                    }
                                    FormRow {
                                        label: "API key";
                                        key-field := TextField {
                                            text: root.api-key-masked;
                                            placeholder: "Paste your key, then Enter";
                                            accepted(t) => { root.save-engine(url-field.text, t); }
                                        }
                                        ActionButton {
                                            label: "Save";
                                            clicked => { root.save-engine(url-field.text, key-field.text); }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 100px;
                                        Text {
                                            text: root.api-key-masked == ""
                                                ? "No key set. Aria needs one to talk: every reply comes from this endpoint."
                                                : "Key saved. Replies, tools and idle moments all go through this endpoint.";
                                            color: Theme.text-muted;
                                            font-size: 11.5px;
                                            font-family: Theme.font-ui;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            Section {
                                title: "Desktop window";
                                Card {
                                    pad-x: 4px;
                                    pad-y: 4px;
                                    gap: 0px;
                                    ToggleRow {
                                        label: "Auto-hide chat bar";
                                        hint: "Right-click her to show the bar; it hides after a few idle seconds";
                                        checked: root.capsule-autohide;
                                        toggled(v) => { root.toggle-capsule-autohide(v); }
                                    }
                                }
                            }

                            Section {
                                title: "Shortcuts";
                                Card {
                                    gap: 8px;
                                    Shortcut { keys: "Alt+Space"; action: "Summon and focus the command bar"; }
                                    Shortcut { keys: "Ctrl+Shift+M"; action: "Start or stop the microphone"; }
                                    Shortcut { keys: "Ctrl+Shift+C"; action: "Open this Control Center"; }
                                    Shortcut { keys: "Right-click"; action: "Show the chat bar (its ⋯ button opens the menu)"; }
                                    Shortcut { keys: "Middle-click"; action: "Quick-dial action ring"; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- Status strip ----
        Rectangle {
            height: 40px;
            background: Theme.surface-sunken;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.hairline;
            }
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 12px;
                spacing: 12px;
                Text {
                    text: root.status-text;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    font-family: Theme.font-ui;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    ActionButton {
                        label: root.subtitles ? "Subtitles on" : "Subtitles off";
                        icon: Glyph.bubble;
                        active: root.subtitles;
                        clicked => { root.toggle-subtitles(!root.subtitles); }
                    }
                }
            }
        }
    }
}
